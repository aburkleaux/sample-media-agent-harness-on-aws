# Example environment file. Copy to `.env` and fill in real values.
#
# This file is `source`d into the shell before running the UI dev server
# (the Vite proxy reads these via `process.env`, and the React UI reads the
# `VITE_*` prefixed vars via `import.meta.env`).
#
#     cp .env.example .env
#     # edit .env with real values
#     source .env
#     cd ui && npm run dev

# ── Main Agent (/api) ────────────────────────────────────────────────────
# Required. AgentCore runtime ARN for the Main Agent.
export AGENT_RUNTIME_ARN=""

# ── Gateway (/catalog) ───────────────────────────────────────────────────
# Required. Gateway MCP endpoint URL.
export GATEWAY_URL=""

# Required for Gateway OAuth (used by /catalog).
export M2M_TOKEN_ENDPOINT=""
export M2M_CLIENT_ID=""
export M2M_CLIENT_SECRET=""
export M2M_SCOPE=""

# ── Optional runtimes ────────────────────────────────────────────────────
# Optional. Task Agent runtime ARN, used by /dispatch.
export TASK_AGENT_RUNTIME_ARN=""

# Optional. Legacy Lab Service runtime ARN. Leave unset so /lab forwards to
# the Main Agent's bypass path; only set this to re-pin to a separate Lab
# Service runtime.
# export LAB_SERVICE_RUNTIME_ARN=""

# ── Memory / sessions / uploads ──────────────────────────────────────────
# Required. AgentCore Memory ID (CDK output `MemoryId`).
export MEMORY_ID=""

# Required. S3 bucket for /upload (mirror of CDK output `SkillsBucketName`).
export UPLOAD_BUCKET=""

# Required. DynamoDB sessions table for the chat sidebar (mirror of CDK
# output `SessionsTableName`).
export SESSIONS_TABLE=""

# ── Async-job-tracking (/jobs) ───────────────────────────────────────────
# Required for /jobs read endpoints. DynamoDB JobRegistry table name
# (mirror of CDK output `JobRegistryTableName`). When unset, /jobs returns
# a 500 with an explanatory error.
export JOB_REGISTRY_TABLE=""

# Optional. GSI name on the JobRegistry table used for actor-scoped
# listings (PK actorId, SK updatedAt). Defaults to "actor-status-index";
# only set this if the CDK output `JobRegistryActorStatusIndexName` differs.
# export JOB_REGISTRY_ACTOR_STATUS_INDEX="actor-status-index"

# Required for /jobs/stream (SSE push channel). SQS FIFO queue URL fed by
# the changefeed-fanout Lambda (mirror of CDK output `JobFanoutQueueUrl`).
# When unset, /jobs/stream returns 500.
export JOB_FANOUT_QUEUE_URL=""

# Optional. CloudFront distribution domain for artifact URLs.
# export ARTIFACTS_DOMAIN=""

# Optional. Defaults to us-west-2.
# export AWS_REGION="us-west-2"

# ── Local development authentication (R7) ───────────────────────────────
# These power the "Dev Login" path documented in README.md. They MUST NOT
# be enabled in production deployments — `*_BYPASS_AUTH=true` short-circuits
# JWT validation in the proxy and lets the UI mint tokens for itself.

# UI flag. Set to "true" to render the "Dev Login" button and skip the
# Cognito hosted-UI redirect. Off by default in prod.
# VITE_DEV_BYPASS_AUTH="true"

# Proxy flag. Set to "true" to short-circuit JWT validation in
# `ui/agentcore-proxy.ts` and inject `X-Actor-Id: ${LAB_DEFAULT_ACTOR_ID}`
# (defaults to `local-dev-user`). Pair with `VITE_DEV_BYPASS_AUTH=true`.
# Off by default in prod.
# export DEV_BYPASS_AUTH="true"

# Cognito user pool ID for the human-auth pool (CDK output `UserPoolId`).
# Required for the real Cognito flow; ignored when `VITE_DEV_BYPASS_AUTH=true`.
# VITE_USER_POOL_ID=""

# Cognito user pool app client ID (CDK output `UserPoolClientId`).
# Required for the real Cognito flow; ignored when `VITE_DEV_BYPASS_AUTH=true`.
# VITE_USER_POOL_CLIENT_ID=""

# AWS region for the user pool. Defaults to "us-west-2".
# VITE_REGION="us-west-2"

# Proxy-side (Node) variants. Read by `ui/auth/validateJwt.ts` to verify
# every JWT the browser sends. Required UNLESS `DEV_BYPASS_AUTH=true`.
# `USER_POOL_ISSUER` is the CDK output `UserPoolIssuer` — i.e. the discovery
# URL with `/.well-known/openid-configuration` stripped. `USER_POOL_CLIENT_ID`
# is the same value as `VITE_USER_POOL_CLIENT_ID`; it's used as the expected
# `aud` claim on inbound tokens.
# export USER_POOL_ISSUER="https://cognito-idp.us-west-2.amazonaws.com/<UserPoolId>"
# export USER_POOL_CLIENT_ID=""

# Optional. HS256 signing secret used by the UI's `signInDev()` to mint a
# fake JWT. Defaults to `dev-secret-do-not-use-in-prod`. Only meaningful
# when `VITE_DEV_BYPASS_AUTH=true`; the proxy short-circuits validation
# either way, so this value is not checked downstream during local dev.
# VITE_DEV_JWT_SECRET="dev-secret-do-not-use-in-prod"

# Optional. Server-side variant of the dev JWT secret. Only needed if the
# proxy is reconfigured to validate dev tokens; in the current setup the
# proxy bypasses validation entirely when `DEV_BYPASS_AUTH=true`, so this
# is unused.
# export DEV_JWT_SECRET="dev-secret-do-not-use-in-prod"

# Optional. Subject claim used by the proxy when `DEV_BYPASS_AUTH=true`.
# Defaults to `local-dev-user`.
# export LAB_DEFAULT_ACTOR_ID="local-dev-user"
