{
  "description": "Document recall policy (agent/src/project_search/document_recall.py and its twin ui/server/projects/documentRecall.ts). A plain text query that could want documents also runs as `<term> #<documentScope>`; only that call's NEW document hits are merged in by final_score, the plain result first on ties. Both suites assert `scopedQueryPattern` byte-for-byte and every case below. `documentScope` must equal ingestion/documents.py DOCUMENT_SCOPE (the scope document pages are indexed under).",
  "documentScope": "scene",
  "scopedQueryPattern": "#(?:shot|scene|utterance|topic)\\b|\\b(?:says|shows):",
  "companionCases": [
    {
      "args": {
        "search_term": "suggested rating"
      },
      "kinds": null,
      "expect": "suggested rating #scene"
    },
    {
      "args": {
        "search_term": "suggested rating"
      },
      "kinds": [
        "document",
        "video"
      ],
      "expect": "suggested rating #scene"
    },
    {
      "args": {
        "search_term": "suggested rating"
      },
      "kinds": [
        "video"
      ],
      "expect": null,
      "note": "documents excluded by the caller"
    },
    {
      "args": {
        "search_term": "cars #shot"
      },
      "kinds": null,
      "expect": null
    },
    {
      "args": {
        "search_term": "x #Topic"
      },
      "kinds": null,
      "expect": null
    },
    {
      "args": {
        "search_term": "says:\"hello\""
      },
      "kinds": null,
      "expect": null
    },
    {
      "args": {
        "search_term": "shows:\"a sign\""
      },
      "kinds": null,
      "expect": null
    },
    {
      "args": {
        "search_term": "the hashtag #scenery"
      },
      "kinds": null,
      "expect": "the hashtag #scenery #scene",
      "note": "#scenery is not a scope tag"
    },
    {
      "args": {
        "search_term": "   "
      },
      "kinds": null,
      "expect": null
    },
    {
      "args": {
        "search_image_s3uri": "s3://b/k.jpg"
      },
      "kinds": null,
      "expect": null
    }
  ],
  "mergeCases": [
    {
      "note": "documents merge in by score; companion video scenes are never taken; a document already present is not duplicated",
      "primary": [
        {
          "asset_id": "video:a",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 1.0
        },
        {
          "asset_id": "video:b",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 0.6
        },
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 0.5
        }
      ],
      "companion": [
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 1.0
        },
        {
          "asset_id": "video:c",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 0.9
        },
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 10000,
          "end_ms": 10001,
          "final_score": 0.6
        },
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 20000,
          "end_ms": 20001,
          "final_score": 0.3
        }
      ],
      "expect": [
        [
          "video:a",
          0
        ],
        [
          "video:b",
          0
        ],
        [
          "document:11111111-1111-4111-8111-111111111111",
          10000
        ],
        [
          "document:11111111-1111-4111-8111-111111111111",
          0
        ],
        [
          "document:11111111-1111-4111-8111-111111111111",
          20000
        ]
      ]
    },
    {
      "note": "no document in the companion: the primary unchanged",
      "primary": [
        {
          "asset_id": "video:a",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 1.0
        }
      ],
      "companion": [
        {
          "asset_id": "video:z",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 1.0
        }
      ],
      "expect": [
        [
          "video:a",
          0
        ]
      ]
    },
    {
      "note": "an empty primary takes the companion's documents in order",
      "primary": [],
      "companion": [
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 0.9
        },
        {
          "asset_id": "video:c",
          "start_ms": 0,
          "end_ms": 1,
          "final_score": 0.8
        },
        {
          "asset_id": "document:11111111-1111-4111-8111-111111111111",
          "start_ms": 30000,
          "end_ms": 30001,
          "final_score": 0.4
        }
      ],
      "expect": [
        [
          "document:11111111-1111-4111-8111-111111111111",
          0
        ],
        [
          "document:11111111-1111-4111-8111-111111111111",
          30000
        ]
      ]
    }
  ]
}
