{
  "name": "agent-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://github.com/aws-samples/sample-media-agent-harness-on-aws",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws-samples/sample-media-agent-harness-on-aws.git",
    "directory": "ui"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=server-dist/index.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:colors": "node scripts/check-no-raw-hex.mjs",
    "lint:styles": "node scripts/check-style-tokens.mjs",
    "lint": "npm run lint:colors && npm run lint:styles",
    "build:deploy": "tsc -p tsconfig.build.json && vite build"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock": "^3.1019.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1063.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1063.0",
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-sfn": "^3.1094.0",
    "@aws-sdk/client-sqs": "^3.1063.0",
    "@aws-sdk/credential-provider-node": "^3.972.26",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@smithy/protocol-http": "^5.3.12",
    "@smithy/signature-v4": "^5.3.12",
    "busboy": "^1.6.0",
    "express": "^4.22.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "^3.2.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.12",
    "fast-check": "^4.8.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
